# .env.local
# Base .env for HTTP-only deployments (--no-https or an IP address).
# setup.sh copies this to deploy/.env on the first run, then adds the domain,
# generated secrets and instancer settings.
COMPOSE_PROJECT_NAME=ctfd_infra

# Host port published for HTTPS (Traefik's self-signed :443 entrypoint)
HTTPS_PORT=443
