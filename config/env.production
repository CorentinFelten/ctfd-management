# .env.production
# Environment variables for PRODUCTION DEPLOYMENT
COMPOSE_PROJECT_NAME=ctfd_infra
BASE_DOMAIN=your-domain.com
ENTRYPOINTS=websecure
ENABLE_TLS=true
TLS_RESOLVER=letsencrypt
TLS_OPTIONS=securetls@file
MIDDLEWARES=security-headers@file
REDIRECT_MIDDLEWARE=redirect-to-https@file

SECRET_KEY=SecretKeyHere
LOG_LEVEL=INFO
ACME_ENABLED=true
ACME_EMAIL=
HTTPS_PORT=443
DYNAMIC_CONFIG=./dynamic.yml
LETSENCRYPT_DIR=../letsencrypt

DNS_PROVIDER=cloudflare
# Provider credentials are NOT stored here: the setup wizard writes them to
# traefik.env (chmod 600), the only env file Traefik receives. You can also
# set them there manually — see lib/dns.sh for required variables per provider.